{
  "manifest_version": 3,
  "name": "Site Checker: DNS, SSL & Security Audit",
  "version": "1.0.1",
  "description": "One-click website audit: DNS, SSL, security headers, tech stack and speed. 44 checks plus a PDF report.",
  "action": {
    "default_title": "Check this website"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "app.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}